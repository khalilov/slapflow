flowchart LR
  DOM["DOM event"] --> Slapflow["Slapflow binding"]
  SYNTHETIC["Synthetic event<br/>API, timer, worker"] --> BUS["PubSubBehavior"]
  TRANSPORT["WebSocket transport"] --> WS["WebSocket bridge"]
  WS --> BUS
  BUS --> WS
  WS --> TRANSPORT
  BUS --> Slapflow

  Slapflow --> CONCURRENCY["Concurrency lanes / worker pools"]
  CONCURRENCY --> RUNNER["Behavior runner"]
  RUNNER --> CONDITIONS["Conditions"]
  CONDITIONS --> ACTIONS["Actions"]
  ACTIONS --> RESULT["Run result"]

  ACTIONS --> POOL["runtime.enqueue fan-out"]
  POOL --> CONCURRENCY

  RUNNER --> DIAGNOSTICS["slapflow.* diagnostics"]
  DIAGNOSTICS --> BUS
  RESULT --> DIAGNOSTICS
