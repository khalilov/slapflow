{
  "name": "slapflow",
  "version": "1.0.1",
  "description": "Chain actions behavior runtime",
  "license": "ISC",
  "author": "Sergey Khalilov",
  "keywords": [
    "behavior",
    "workflow",
    "action-runner",
    "rules-engine",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalilov/slapflow.git"
  },
  "bugs": {
    "url": "https://github.com/khalilov/slapflow/issues"
  },
  "homepage": "https://github.com/khalilov/slapflow#readme",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "SPEC.md",
    "SPEC-RU.md",
    "RUNTIME-FLOW.mmd",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "sideEffects": false,
  "dependencies": {
    "objwalk": "^1.1.0"
  }
}
