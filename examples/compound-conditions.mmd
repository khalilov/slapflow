flowchart TD
  LOAD["catalog.load<br/>core.fetch"]
  VALID{"body is a record<br/>and items is a non-empty array?"}
  EMPTY{"items is missing<br/>or empty?"}
  OFFLINE{"offline and source is<br/>startup or refresh?"}
  REPORT{"online or<br/>source is manual?"}
  APPLY["catalog.apply"]
  SHOW_EMPTY["catalog.showEmpty"]
  QUEUE_RETRY["catalog.queueRetry"]
  SHOW_ERROR["catalog.showError"]
  UNHANDLED["failure remains unhandled"]

  LOAD -->|then| VALID
  VALID -->|yes| APPLY
  VALID -->|no| EMPTY
  EMPTY -->|yes| SHOW_EMPTY
  LOAD -->|catch| OFFLINE
  OFFLINE -->|yes| QUEUE_RETRY
  OFFLINE -->|no| REPORT
  REPORT -->|yes| SHOW_ERROR
  REPORT -->|no| UNHANDLED
